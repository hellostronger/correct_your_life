# 微信公众号监控服务（WeRSS）独立配置 · 复制为 .env 后按需修改
#   cp .env.example .env

# 宿主机映射端口（stock-advisor 里填的地址要用这个端口）
WERSS_PORT=8001

# Web UI 登录凭据。**远程部署务必改掉默认密码**
WERSS_USERNAME=admin
WERSS_PASSWORD=admin@123

# 数据目录（相对本文件）。SQLite 库、文章缓存、微信读书 Chrome profile 都在这里，
# 备份就备份这个目录
WERSS_DATA_DIR=./data

# 时区。不设对会导致「文章发布时间」整体偏移，进而影响「只看今天」这类判断
TZ=Asia/Shanghai

# 数据库。默认 SQLite（单文件，够用且不用额外容器）
#   sqlite:///data/db.db
# 换 MySQL 见 README「换 MySQL」
WERSS_DB=sqlite:///data/db.db

# 代码热重载。长期运行的服务请保持 False，否则改文件会自动重启
WERSS_AUTO_RELOAD=False

# 出口代理。仅当这台服务器直连不上微信读书/微信时才需要
WERSS_PROXY_ENABLED=False
WERSS_PROXY_URL=socks5://user:pass@host:port

# 固定上游镜像版本（想用官方镜像直接拉、不本地构建时改这里用）
# WERSS_IMAGE=ghcr.io/rachelos/we-mp-rss:latest
