# 环境变量 / 密钥
.env

# Stock Advisor 真实配置（含密钥，不入库；模板见 config.example.yaml）
stock-advisor/config.yaml

# Python 运行产物
__pycache__/
*.py[cod]
*.log

# 运行时数据
stock-advisor/data/
stock-advisor/reports/

# Docker 运行时卷（browser_data 登录态、爬虫产出 jsonl）
mediacrawler-browser/
mediacrawler-data/

# MediaCrawler 以 git submodule 跟踪（指向 hellostronger/MediaCrawler，锁定补丁版）
# 注意：MediaCrawler 内部的运行产物由其自己的 .gitignore 管理
